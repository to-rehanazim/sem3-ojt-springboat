package com.pwioi.jdbc;

import java.io.FileOutputStream;
import java.io.FileWriter;
import java.io.IOException;
import java.io.InputStream;
import java.io.Reader;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.Scanner;

import com.pwioi.jdbc.config.DBConfig;

public class BinarySelectDemo {

	public static void main(String[] args) throws IOException {
		
		InputStream dbPhoto = null;
		Reader dbResume = null;
		
		
		try (// TODO Auto-generated method stub
		 Connection con = DBConfig.getDBConnection();
		 PreparedStatement pstmt = con.prepareStatement("select name,photo,resume from profile where id=?");
		 FileOutputStream fos = new FileOutputStream("db_profile.jpeg");
		 FileWriter fw = new FileWriter("db_resume.txt");
				) {
			
			System.out.println("Database Connection Established !");
			
			Scanner sc = new Scanner(System.in);
			System.out.println("Enter id of the profile to be serched:");
				
			int profileId = sc.nextInt();
			pstmt.setInt(1, profileId);
			
			ResultSet rs = pstmt.executeQuery();
			if(rs.next()) {
				String profileName = rs.getString(1);
				System.out.println("Profile Name is: " + profileName);
				
			    dbPhoto = rs.getBinaryStream(2);
				byte[] imageData = dbPhoto.readAllBytes();
				fos.write(imageData);
				
				dbResume = rs.getCharacterStream("resume");
				int txtData = 0;
				while((txtData=dbResume.read()) != 1)
					fw.write(txtData);
				
					
				System.out.println("Data is read successfully");
				
				
			
			}else {
				System.out.println("Sorry! profile not found");
			}
		} catch (SQLException e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		}finally {
			try {
				if(dbPhoto != null) 
					dbPhoto.close();
				if(dbResume !=null)
					dbResume.close();
			} catch (IOException e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			}
			
		}

	}

}